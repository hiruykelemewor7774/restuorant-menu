generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model AdminAuth {
  id        Int      @id @default(autoincrement())
  username  String   @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_auth")
}

model Waiter {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // hashed password (bcrypt)
  fullName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@map("waiters")
}

model Kitchen {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // hashed password (bcrypt)
  fullName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kitchen")
}

model Table {
  id          String   @id @default(cuid())
  tableNumber String   @unique
  qrCode      String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@map("tables")
}

model Order {
  id            String      @id @default(cuid())
  tableNumber   String
  tableId       String?
  table         Table?      @relation(fields: [tableId], references: [id])
  waiterId      String?
  waiter        Waiter?     @relation(fields: [waiterId], references: [id])
  status        String      @default("pending")
  source        String      @default("waiter")
  notes         String?     @db.Text
  paymentStatus String      @default("unpaid") // unpaid | paid | failed
  paymentRef    String?     @unique
  totalAmount   Float       @default(0)
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name       String
  price      String
  quantity   Int    @default(1)
  category   String // "Food" | "Drink" | "Room"

  @@map("order_items")
}

model MenuItem {
  id        String   @id @default(cuid())
  type      String   // "Food" | "Drink" | "Room"
  category  String   // ለ Food/Drink: "Traditional", "Hot Drink" ወዘተ. ለ Room: ""
  name      String
  price     String
  image     String
  features  String?  @db.Text // ለ Room ብቻ: JSON array string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menu_items")
}