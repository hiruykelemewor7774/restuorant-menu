generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminAuth {
  id        Int      @id @default(autoincrement())
  username  String   @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_auth")
}

model Waiter {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // hashed password (bcrypt)
  fullName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@map("waiters")
}

model Kitchen {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // hashed password (bcrypt)
  fullName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]

  @@map("kitchen")
}

model Table {
  id          String   @id @default(cuid())
  tableNumber String   @unique
  qrCode      String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@map("tables")
}

model Order {
  id            String      @id @default(cuid())
  tableNumber   String
  tableId       String?
  table         Table?      @relation(fields: [tableId], references: [id])
  waiterId      String?
  waiter        Waiter?     @relation(fields: [waiterId], references: [id])
  kitchenId     String?
  kitchen       Kitchen?    @relation(fields: [kitchenId], references: [id])
  status        String      @default("pending")
  source        String      @default("waiter")
  notes         String?     @db.Text
  paymentStatus String      @default("unpaid")
  paymentMethod String?
  paymentRef    String?     @unique
  totalAmount   Float       @default(0)
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name       String
  price      String
  quantity   Int    @default(1)
  category   String // "Food" | "Drink" | "Room"

  @@map("order_items")
}

model MenuItem {
  id        String   @id @default(cuid())
  type      String   // "Food" | "Drink" | "Room"
  category  String   // ለ Food/Drink: "Traditional", "Hot Drink" ወዘተ. ለ Room: ""
  name      String
  price     String
  image     String
  features  String?  @db.Text // ለ Room ብቻ: JSON array string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menu_items")
}

model StoreAuth {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  fullName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_auth")
}

model StoreItem {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("General")
  unit         String
  quantity     Float    @default(0)
  minThreshold Float    @default(0)
  costPerUnit  Float    @default(0)
  expiryDate   DateTime?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases    Purchase[]
  wasteLogs    WasteLog[]
  requestItems KitchenRequestItem[]
  recipeItems  RecipeItem[]

  @@map("store_items")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@map("suppliers")
}

model Purchase {
  id          String   @id @default(cuid())
  itemId      String
  item        StoreItem @relation(fields: [itemId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  quantity    Float
  totalCost   Float
  purchasedAt DateTime @default(now())
  notes       String?  @db.Text

  @@map("purchases")
}

model KitchenRequest {
  id        String   @id @default(cuid())
  status    String   @default("pending") // pending | approved | rejected
  requestedBy String?
  notes     String?  @db.Text
  items     KitchenRequestItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kitchen_requests")
}

model KitchenRequestItem {
  id         String  @id @default(cuid())
  requestId  String
  request    KitchenRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId     String
  item       StoreItem @relation(fields: [itemId], references: [id])
  quantity   Float

  @@map("kitchen_request_items")
}

model WasteLog {
  id        String   @id @default(cuid())
  itemId    String
  item      StoreItem @relation(fields: [itemId], references: [id])
  quantity  Float
  reason    String?
  createdAt DateTime @default(now())

  @@map("waste_logs")
}

model Recipe {
  id        String   @id @default(cuid())
  name      String
  notes     String?  @db.Text
  items     RecipeItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recipes")
}

model RecipeItem {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  itemId   String
  item     StoreItem @relation(fields: [itemId], references: [id])
  quantity Float

  @@map("recipe_items")
}